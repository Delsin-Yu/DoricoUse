<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>project-file-check</AssemblyName>
    <RootNamespace>DoricoUse.ProjectFileCheck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      B2: same bar as the CLI - the house style and the analyzers are enforced here too, and a warning fails the
      build, because a check that is allowed to warn stops being read.
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The check compiles the reader's own sources instead of referencing the CLI: the CLI is an executable with a
    top-level Program, and the point here is to exercise the file parser on its own, with no Dorico and no host.
  -->
  <ItemGroup>
    <Compile Include="../../src/DoricoUse.Cli/CliException.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Dorico/ProjectFile*.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Dorico/NodeRead.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Dorico/LiveReadDump.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Dorico/LivePlayersDump.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Dorico/DoricoProtocol.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Json/JsonArr.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Views/Pattern.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Views/ProjectFileView.cs" />
    <Compile Include="../../src/DoricoUse.Cli/Views/ProjectFileView.Marks.cs" />
  </ItemGroup>

</Project>
