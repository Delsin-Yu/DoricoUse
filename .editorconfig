root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,csproj,slnx,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
# The house style the existing code already follows.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_prefer_braces = when_multiline:silent
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:silent
dotnet_sort_system_directives_first = true
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1303.severity = none

# CA1001: these two own a CancellationTokenSource and a SemaphoreSlim that live until the process ends, so nothing
# would ever call a Dispose - and a Dispose here would only race the connection handlers still finishing a request.
[src/DoricoUse.Cli/Host/HostServer.cs]
dotnet_diagnostic.CA1001.severity = none

[src/DoricoUse.Cli/Host/SessionKeeper.cs]
dotnet_diagnostic.CA1001.severity = none
