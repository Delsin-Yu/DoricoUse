<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The CLI reads Dorico's windows and presses their buttons through Win32 and UI Automation, so it targets
      Windows. The two check projects stay on net10.0 and compile the CLI's sources by hand; everything that needs
      a Windows API therefore lives under Ui/, in files only this project compiles.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      The UI Automation calls go through raw COM vtable pointers: the built-in COM marshaller generates its stubs at
      run time and a Native AOT image cannot do that. Everything else in the project is ordinary safe C#.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dorico-use</AssemblyName>
    <RootNamespace>DoricoUse.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>the dorico-use contributors</Authors>
    <Description>Stateless JSON CLI for steering Dorico through its Remote Control API</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <!--
      B2: the house style in .editorconfig is part of the build, not a suggestion. The analyzer set is
      latest-recommended rather than latest-all because the "all" set fires on rules the SDK itself considers
      unproven; a warning here fails the build, which keeps the 0-warning bar from regressing.
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    B1: the scripting layer is not exposed in any build unless it was asked for. The switch is passed on the
    command line (-p:ExposeUnsafeScriptRunApi=true) while developing; CI and the release workflow never pass it,
    which is what makes a released binary's `version` say the surface is off.
  -->
  <PropertyGroup>
    <ExposeUnsafeScriptRunApi Condition="'$(ExposeUnsafeScriptRunApi)' == 'true'">true</ExposeUnsafeScriptRunApi>
    <DefineConstants Condition="'$(ExposeUnsafeScriptRunApi)' == 'true'">$(DefineConstants);EXPOSE_UNSAFE_SCRIPT_RUN_API</DefineConstants>
  </PropertyGroup>

  <!--
    B3: the session token is written to disk by default, because that is what makes the second run cost a
    millisecond instead of a dialog. -p:NeverPersistSession=true builds one that keeps it in the host's memory
    instead; `version.build.neverPersistSession` reports which one this is, from the constant rather than a
    hand-kept copy of it.
  -->
  <PropertyGroup>
    <NeverPersistSession Condition="'$(NeverPersistSession)' == 'true'">true</NeverPersistSession>
    <DefineConstants Condition="'$(NeverPersistSession)' == 'true'">$(DefineConstants);NEVER_PERSIST_SESSION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

</Project>
